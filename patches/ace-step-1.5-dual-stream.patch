@@ -0,0 +1,189 @@
+"""Per-step joint flow matching for accompaniment/vocal training."""
+
+from __future__ import annotations
+
+from contextlib import nullcontext
+from typing import Any, Dict
+
+import torch
+
+from acestep.training_v2.dual_stream import ACCOMPANIMENT_ROLE, VOCAL_ROLE
+from acestep.training_v2.timestep_sampling import apply_cfg_dropout, sample_timesteps
+
+
+def run_dual_stream_training_step(
+    module: Any,
+    batch: Dict[str, torch.Tensor],
+    *,
+    record_loss: bool = True,
+    apply_condition_dropout: bool = True,
+) -> torch.Tensor:
+    """Compute joint flow loss at one shared timestep for both targets."""
+    if module.device_type in ("cuda", "xpu", "mps") and module.dtype != torch.float32:
+        autocast_ctx = torch.autocast(device_type=module.device_type, dtype=module.dtype)
+    else:
+        autocast_ctx = nullcontext()
+
+    with autocast_ctx:
+        nb = module.transfer_non_blocking
+        accompaniment_target = batch["accompaniment_target_latents"].to(
+            module.device, module.dtype, non_blocking=nb
+        )
+        accompaniment_mask = batch["accompaniment_target_attention_mask"].to(
+            module.device, module.dtype, non_blocking=nb
+        )
+        vocal_target = batch["vocal_target_latents"].to(
+            module.device, module.dtype, non_blocking=nb
+        )
+        vocal_mask = batch["vocal_target_attention_mask"].to(
+            module.device, module.dtype, non_blocking=nb
+        )
+        motif_condition = batch["motif_seed_latents"].to(
+            module.device, module.dtype, non_blocking=nb
+        )
+        motif_mask = batch["motif_seed_attention_mask"].to(
+            module.device, module.dtype, non_blocking=nb
+        )
+        accompaniment_base_condition = batch["accompaniment_encoder_hidden_states"].to(
+            module.device, module.dtype, non_blocking=nb
+        )
+        accompaniment_base_mask = batch["accompaniment_encoder_attention_mask"].to(
+            module.device, module.dtype, non_blocking=nb
+        )
+        vocal_base_condition = batch["vocal_encoder_hidden_states"].to(
+            module.device, module.dtype, non_blocking=nb
+        )
+        vocal_base_mask = batch["vocal_encoder_attention_mask"].to(
+            module.device, module.dtype, non_blocking=nb
+        )
+
+        t, _ = sample_timesteps(
+            batch_size=accompaniment_target.shape[0],
+            device=module.device,
+            dtype=module.dtype,
+            data_proportion=module._data_proportion,
+            timestep_mu=module._timestep_mu,
+            timestep_sigma=module._timestep_sigma,
+            use_meanflow=False,
+        )
+        t_ = t.unsqueeze(-1).unsqueeze(-1)
+        accompaniment_noise = torch.randn_like(accompaniment_target)
+        vocal_noise = torch.randn_like(vocal_target)
+        accompaniment_xt = t_ * accompaniment_noise + (1.0 - t_) * accompaniment_target
+        vocal_xt = t_ * vocal_noise + (1.0 - t_) * vocal_target
+        if module.force_input_grads_for_checkpointing:
+            accompaniment_xt = accompaniment_xt.requires_grad_(True)
+            vocal_xt = vocal_xt.requires_grad_(True)
+
+        conditioner = _get_conditioner(module)
+        if apply_condition_dropout and module._null_cond_emb is not None and module._cfg_ratio > 0.0:
+            accompaniment_base_condition = apply_cfg_dropout(
+                accompaniment_base_condition, module._null_cond_emb, module._cfg_ratio
+            )
+            vocal_base_condition = apply_cfg_dropout(
+                vocal_base_condition, module._null_cond_emb, module._cfg_ratio
+            )
+        accompaniment_condition, accompaniment_condition_mask = conditioner.build_condition(
+            accompaniment_base_condition,
+            accompaniment_base_mask,
+            ACCOMPANIMENT_ROLE,
+        )
+        vocal_condition, vocal_condition_mask = conditioner.build_condition(
+            vocal_base_condition,
+            vocal_base_mask,
+            VOCAL_ROLE,
+        )
+
+        accompaniment_pred = _decode(
+            module,
+            target_latents=accompaniment_xt,
+            target_mask=accompaniment_mask,
+            peer_latents=vocal_xt.detach(),
+            peer_mask=vocal_mask,
+            motif_condition=motif_condition,
+            motif_mask=motif_mask,
+            condition=accompaniment_condition,
+            condition_mask=accompaniment_condition_mask,
+            timestep=t,
+        )
+        vocal_pred = _decode(
+            module,
+            target_latents=vocal_xt,
+            target_mask=vocal_mask,
+            peer_latents=accompaniment_xt.detach(),
+            peer_mask=accompaniment_mask,
+            motif_condition=motif_condition,
+            motif_mask=motif_mask,
+            condition=vocal_condition,
+            condition_mask=vocal_condition_mask,
+            timestep=t,
+        )
+        loss = (
+            module.training_config.accompaniment_loss_weight
+            * _masked_flow_loss(
+                accompaniment_pred,
+                accompaniment_noise - accompaniment_target,
+                accompaniment_mask,
+            )
+            + module.training_config.vocal_loss_weight
+            * _masked_flow_loss(vocal_pred, vocal_noise - vocal_target, vocal_mask)
+        )
+
+    loss = loss.float()
+    if record_loss:
+        module.training_losses.append(loss.item())
+    return loss
+
+
+def _decode(
+    module: Any,
+    *,
+    target_latents: torch.Tensor,
+    target_mask: torch.Tensor,
+    peer_latents: torch.Tensor,
+    peer_mask: torch.Tensor,
+    motif_condition: torch.Tensor,
+    motif_mask: torch.Tensor,
+    condition: torch.Tensor,
+    condition_mask: torch.Tensor,
+    timestep: torch.Tensor,
+) -> torch.Tensor:
+    """Run ``[peer | mask | target]`` plus the temporal motif condition."""
+    latent_dim = target_latents.shape[-1]
+    shared_mask = target_mask * peer_mask * motif_mask
+    masked_peer = peer_latents * shared_mask.unsqueeze(-1)
+    masked_motif = motif_condition * shared_mask.unsqueeze(-1)
+    chunk_mask = shared_mask.unsqueeze(-1).expand(-1, -1, latent_dim)
+    context = torch.cat([masked_peer, chunk_mask, masked_motif], dim=-1)
+    return module.model.decoder(
+        hidden_states=target_latents,
+        timestep=timestep,
+        timestep_r=timestep,
+        attention_mask=shared_mask,
+        encoder_hidden_states=condition,
+        encoder_attention_mask=condition_mask,
+        context_latents=context,
+    )[0]
+
+
+def _masked_flow_loss(
+    prediction: torch.Tensor,
+    target: torch.Tensor,
+    mask: torch.Tensor,
+) -> torch.Tensor:
+    """Return MSE over valid audio frames, excluding collate padding."""
+    weights = mask.unsqueeze(-1).to(dtype=prediction.dtype)
+    return ((prediction - target).square() * weights).sum() / (
+        weights.sum() * prediction.shape[-1]
+    ).clamp_min(1.0)
+
+
+def _get_conditioner(module: Any) -> Any:
+    """Find the conditioner through optional Fabric wrappers."""
+    decoder = module.model.decoder
+    while hasattr(decoder, "_forward_module"):
+        decoder = decoder._forward_module
+    conditioner = getattr(decoder, "dual_stream_conditioner", None)
+    if conditioner is None:
+        raise RuntimeError("Dual-stream conditioner is not attached to the decoder.")
+    return conditioner
