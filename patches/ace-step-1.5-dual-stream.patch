+"""Unit tests for the cover-style dual-stream adapter."""
+
+import tempfile
+import unittest
+from pathlib import Path
+
+import torch
+import torch.nn as nn
+
+from acestep.training.data_module import PreprocessedDataModule
+from acestep.training_v2.dual_stream import (
+    ACCOMPANIMENT_ROLE,
+    VOCAL_ROLE,
+    DualStreamConditioner,
+    DualStreamInputProjection,
+    attach_dual_stream_conditioner,
+)
+
+
+class _DecoderCore(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.proj_in = nn.Linear(6, 4, bias=False)
+
+
+class _ForwardingWrapper(nn.Module):
+    """Approximate PEFT's forwarded attribute lookup around the real decoder."""
+
+    def __init__(self, base_model):
+        super().__init__()
+        self.base_model = base_model
+
+    def __getattr__(self, name):
+        try:
+            return super().__getattr__(name)
+        except AttributeError:
+            return getattr(self.base_model, name)
+
+
+class DualStreamConditionerTests(unittest.TestCase):
+    def _modules(self):
+        base = nn.Linear(6, 4, bias=False)
+        conditioner = DualStreamConditioner(
+            latent_dim=2,
+            condition_dim=4,
+            hidden_dim=4,
+            patch_size=1,
+        )
+        projection = DualStreamInputProjection(base, conditioner)
+        return base, conditioner, projection
+
+    def test_zero_init_exactly_preserves_pretrained_projection(self):
+        base, _, projection = self._modules()
+        combined = torch.randn(2, 5, 8)
+        expected_base_input = torch.cat([combined[..., :4], combined[..., 6:]], dim=-1)
+        self.assertTrue(torch.equal(projection(combined), base(expected_base_input)))
+
+    def test_motif_projection_receives_gradients_and_leaves_zero(self):
+        _, conditioner, projection = self._modules()
+        optimizer = torch.optim.SGD(conditioner.parameters(), lr=0.1)
+        combined = torch.randn(2, 5, 8)
+        projection(combined).sum().backward()
+        self.assertIsNotNone(conditioner.motif_projection.weight.grad)
+        optimizer.step()
+        self.assertGreater(float(conditioner.motif_projection.weight.abs().sum()), 0.0)
+
+    def test_attachment_replaces_projection_owned_by_forwarded_decoder(self):
+        core = _DecoderCore()
+        wrapper = _ForwardingWrapper(core)
+        combined = torch.randn(2, 5, 8)
+        base_input = torch.cat([combined[..., :4], combined[..., 6:]], dim=-1)
+        expected = core.proj_in(base_input)
+
+        attach_dual_stream_conditioner(
+            wrapper,
+            latent_dim=2,
+            condition_dim=4,
+            hidden_dim=4,
+            patch_size=1,
+        )
+
+        self.assertNotIn("proj_in", wrapper._modules)
+        self.assertIsInstance(core.proj_in, DualStreamInputProjection)
+        self.assertTrue(torch.equal(core.proj_in(combined), expected))
+
+    def test_condition_contains_role_and_text_only(self):
+        _, conditioner, _ = self._modules()
+        base = torch.zeros(1, 3, 4)
+        base_mask = torch.ones(1, 3)
+        accompaniment, accompaniment_mask = conditioner.build_condition(
+            base, base_mask, ACCOMPANIMENT_ROLE
+        )
+        vocal, vocal_mask = conditioner.build_condition(base, base_mask, VOCAL_ROLE)
+        self.assertEqual(accompaniment.shape, (1, 4, 4))
+        self.assertTrue(torch.equal(accompaniment_mask, vocal_mask))
+        self.assertFalse(torch.equal(accompaniment[:, :1], vocal[:, :1]))
+        self.assertTrue(torch.equal(accompaniment[:, 1:], base))
+
+    def test_state_round_trip_includes_role_and_motif_projection(self):
+        _, first, _ = self._modules()
+        with torch.no_grad():
+            first.role_embedding.weight.fill_(0.25)
+            first.motif_projection.weight.fill_(0.5)
+        second = DualStreamConditioner(2, 4, 4, 1)
+        second.load_state_dict(first.state_dict())
+        for key, value in first.state_dict().items():
+            self.assertTrue(torch.equal(value, second.state_dict()[key]))
+
+    def test_train_validation_split_is_reproducible(self):
+        with tempfile.TemporaryDirectory(dir=".") as temp_dir:
+            root = Path(temp_dir)
+            for index in range(10):
+                (root / f"song_{index}.pt").touch()
+            first = PreprocessedDataModule(str(root), val_split=0.2, split_seed=42)
+            second = PreprocessedDataModule(str(root), val_split=0.2, split_seed=42)
+            first.setup("fit")
+            second.setup("fit")
+            self.assertEqual(len(first.train_dataset), 8)
+            self.assertEqual(len(first.val_dataset), 2)
+            self.assertEqual(first.train_dataset.indices, second.train_dataset.indices)
+            self.assertEqual(first.val_dataset.indices, second.val_dataset.indices)
+
+
+if __name__ == "__main__":
+    unittest.main()
