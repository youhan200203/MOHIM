index 0000000..c756b10
--- /dev/null
+++ b/acestep/training_v2/dual_stream_inference.py
@@ -0,0 +1,148 @@
+"""Joint Euler sampler for motif-conditioned accompaniment and vocals."""
+
+from __future__ import annotations
+
+from typing import Tuple
+
+import torch
+
+from acestep.training_v2.dual_stream import (
+    ACCOMPANIMENT_ROLE,
+    VOCAL_ROLE,
+    DualStreamConditioner,
+)
+
+
+@torch.no_grad()
+def sample_dual_stream_latents(
+    decoder: torch.nn.Module,
+    conditioner: DualStreamConditioner,
+    accompaniment_encoder_hidden_states: torch.Tensor,
+    accompaniment_encoder_attention_mask: torch.Tensor,
+    vocal_encoder_hidden_states: torch.Tensor,
+    vocal_encoder_attention_mask: torch.Tensor,
+    motif_seed_latents: torch.Tensor,
+    motif_seed_attention_mask: torch.Tensor,
+    null_condition_emb: torch.Tensor,
+    output_frames: int,
+    latent_dim: int,
+    steps: int = 50,
+    seed: int | None = None,
+    guidance_scale: float = 7.0,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """Denoise accompaniment and vocal trajectories simultaneously."""
+    if output_frames < 1 or latent_dim < 1 or steps < 1 or guidance_scale < 1.0:
+        raise ValueError("output dimensions and steps must be positive; guidance_scale must be >= 1")
+    if motif_seed_latents.shape[1] != output_frames:
+        raise ValueError(
+            "motif_seed_latents must be a full-length motif/silence canvas "
+            f"({motif_seed_latents.shape[1]} vs {output_frames} frames)"
+        )
+    device = accompaniment_encoder_hidden_states.device
+    dtype = accompaniment_encoder_hidden_states.dtype
+    generator = None
+    if seed is not None:
+        generator = torch.Generator(device=device).manual_seed(seed)
+    shape = (
+        accompaniment_encoder_hidden_states.shape[0],
+        output_frames,
+        latent_dim,
+    )
+    accompaniment = torch.randn(shape, device=device, dtype=dtype, generator=generator)
+    vocal = torch.randn(shape, device=device, dtype=dtype, generator=generator)
+    stream_mask = motif_seed_attention_mask.to(device=device, dtype=dtype)
+    chunk_mask = stream_mask.unsqueeze(-1).expand(-1, -1, latent_dim)
+    motif_condition = motif_seed_latents.to(device=device, dtype=dtype) * stream_mask.unsqueeze(-1)
+    times = torch.linspace(1.0, 0.0, steps + 1, device=device, dtype=dtype)
+
+    accompaniment_condition, accompaniment_condition_mask = conditioner.build_condition(
+        accompaniment_encoder_hidden_states,
+        accompaniment_encoder_attention_mask,
+        ACCOMPANIMENT_ROLE,
+    )
+    vocal_condition, vocal_condition_mask = conditioner.build_condition(
+        vocal_encoder_hidden_states,
+        vocal_encoder_attention_mask,
+        VOCAL_ROLE,
+    )
+    accompaniment_unconditional, _ = conditioner.build_condition(
+        null_condition_emb.expand_as(accompaniment_encoder_hidden_states),
+        accompaniment_encoder_attention_mask,
+        ACCOMPANIMENT_ROLE,
+    )
+    vocal_unconditional, _ = conditioner.build_condition(
+        null_condition_emb.expand_as(vocal_encoder_hidden_states),
+        vocal_encoder_attention_mask,
+        VOCAL_ROLE,
+    )
+
+    for index in range(steps):
+        timestep = times[index].expand(shape[0])
+        dt = times[index + 1] - times[index]
+        accompaniment_context = torch.cat(
+            [vocal * stream_mask.unsqueeze(-1), chunk_mask, motif_condition], dim=-1
+        )
+        vocal_context = torch.cat(
+            [accompaniment * stream_mask.unsqueeze(-1), chunk_mask, motif_condition], dim=-1
+        )
+        accompaniment_velocity = _guided_velocity(
+            decoder,
+            accompaniment,
+            stream_mask,
+            accompaniment_condition,
+            accompaniment_unconditional,
+            accompaniment_condition_mask,
+            accompaniment_context,
+            timestep,
+            guidance_scale,
+        )
+        vocal_velocity = _guided_velocity(
+            decoder,
+            vocal,
+            stream_mask,
+            vocal_condition,
+            vocal_unconditional,
+            vocal_condition_mask,
+            vocal_context,
+            timestep,
+            guidance_scale,
+        )
+        accompaniment = accompaniment + dt * accompaniment_velocity
+        vocal = vocal + dt * vocal_velocity
+
+    return accompaniment, vocal
+
+
+def _guided_velocity(
+    decoder: torch.nn.Module,
+    latents: torch.Tensor,
+    attention_mask: torch.Tensor,
+    condition: torch.Tensor,
+    unconditional_condition: torch.Tensor,
+    condition_mask: torch.Tensor,
+    context: torch.Tensor,
+    timestep: torch.Tensor,
+    guidance_scale: float,
+) -> torch.Tensor:
+    """Apply CFG while retaining role, peer, mask, and motif inputs."""
+    if guidance_scale == 1.0:
+        return decoder(
+            hidden_states=latents,
+            timestep=timestep,
+            timestep_r=timestep,
+            attention_mask=attention_mask,
+            encoder_hidden_states=condition,
+            encoder_attention_mask=condition_mask,
+            context_latents=context,
+        )[0]
+    combined_velocity = decoder(
+        hidden_states=torch.cat([latents, latents], dim=0),
+        timestep=torch.cat([timestep, timestep], dim=0),
+        timestep_r=torch.cat([timestep, timestep], dim=0),
+        attention_mask=torch.cat([attention_mask, attention_mask], dim=0),
+        encoder_hidden_states=torch.cat([condition, unconditional_condition], dim=0),
+        encoder_attention_mask=torch.cat([condition_mask, condition_mask], dim=0),
+        context_latents=torch.cat([context, context], dim=0),
+    )[0]
+    conditional, unconditional = combined_velocity.chunk(2)
+    return unconditional + guidance_scale * (conditional - unconditional)
