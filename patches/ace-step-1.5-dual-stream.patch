+def _validation_loss(module: Any, val_loader: Any, cfg: Any) -> Optional[float]:
+    """Evaluate validation with fixed randomness and no condition dropout."""
+    if val_loader is None:
+        return None
+    decoder = module.model.decoder
+    decoder.eval()
+    total_loss = 0.0
+    total_samples = 0
+    cuda_devices = [module.device.index or 0] if module.device_type == "cuda" else []
+    try:
+        with torch.no_grad(), torch.random.fork_rng(devices=cuda_devices):
+            torch.manual_seed(cfg.seed)
+            if module.device_type == "cuda":
+                torch.cuda.manual_seed_all(cfg.seed)
+            for batch in val_loader:
+                loss = module.training_step(
+                    batch,
+                    record_loss=False,
+                    apply_condition_dropout=False,
+                )
+                sample_tensor = batch.get("accompaniment_target_latents", batch["target_latents"])
+                sample_count = int(sample_tensor.shape[0])
+                total_loss += float(loss.item()) * sample_count
+                total_samples += sample_count
+    finally:
+        decoder.train()
+    return total_loss / max(total_samples, 1)
