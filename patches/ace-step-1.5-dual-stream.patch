+        def check_output(_module: Any, _inputs: Any, output: Any, label: str = label) -> None:
+            if not first_bad and _has_nonfinite(output):
+                first_bad.append(label)
+
+        handles.append(module.register_forward_hook(check_output))
+    try:
+        forward()
+    finally:
