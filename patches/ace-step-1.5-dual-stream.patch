+    def _validation_loss(
+        self,
+        val_loader: Any,
+        cfg: TrainingConfigV2,
+        world_size: int,
+    ) -> Optional[float]:
+        """Evaluate a fixed-noise validation objective without condition dropout."""
+        if val_loader is None:
+            return None
+        assert self.module is not None
+        decoder = self.module.model.decoder
+        decoder.eval()
+        total_loss = 0.0
+        total_samples = 0
+        cuda_devices = []
+        if self.module.device_type == "cuda":
+            cuda_devices = [self.module.device.index or 0]
+        try:
+            with torch.no_grad(), torch.random.fork_rng(devices=cuda_devices):
+                torch.manual_seed(cfg.seed)
+                if self.module.device_type == "cuda":
+                    torch.cuda.manual_seed_all(cfg.seed)
+                for batch in val_loader:
+                    loss = self.module.training_step(
+                        batch,
+                        record_loss=False,
+                        apply_condition_dropout=False,
+                    )
+                    sample_tensor = batch.get("accompaniment_target_latents", batch["target_latents"])
+                    sample_count = int(sample_tensor.shape[0])
+                    total_loss += float(loss.item()) * sample_count
+                    total_samples += sample_count
+        finally:
+            decoder.train()
+        totals = torch.tensor(
+            [total_loss, float(total_samples)],
+            device=self.module.device,
+            dtype=torch.float64,
+        )
+        if world_size > 1:
+            totals = self.fabric.all_reduce(totals, reduce_op="sum")
+        return float((totals[0] / totals[1].clamp_min(1.0)).item())
