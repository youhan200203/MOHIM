+def save_rolling_checkpoint(
+    trainer: Any,
+    optimizer: Any,
+    scheduler: Any,
+    epoch: int,
+    global_step: int,
+    checkpoint_dir: str | Path,
+    *,
+    train_loss: Optional[float] = None,
+    val_loss: Optional[float] = None,
+) -> Path:
+    """Atomically rotate an every-epoch checkpoint, retaining one fallback."""
+    destination = Path(checkpoint_dir)
+    staging = destination.with_name(f"{destination.name}.incomplete")
+    previous = destination.with_name(f"{destination.name}.previous")
+    if staging.exists():
+        shutil.rmtree(staging)
+    save_checkpoint(
+        trainer,
+        optimizer,
+        scheduler,
+        epoch,
+        global_step,
+        str(staging),
+        train_loss=train_loss,
+        val_loss=val_loss,
+    )
+    _rotate_checkpoint_directory(staging, destination, previous)
+    return destination
+
+
+def mirror_checkpoint_directory(source: str | Path, destination: str | Path) -> Path:
+    """Copy a complete checkpoint to durable storage using a two-generation rotation."""
+    source_path = Path(source)
+    destination_path = Path(destination)
+    staging = destination_path.with_name(f"{destination_path.name}.incomplete")
+    previous = destination_path.with_name(f"{destination_path.name}.previous")
+    destination_path.parent.mkdir(parents=True, exist_ok=True)
+    if staging.exists():
+        shutil.rmtree(staging)
+    shutil.copytree(source_path, staging)
+    _rotate_checkpoint_directory(staging, destination_path, previous)
+    return destination_path
+
+
+def _rotate_checkpoint_directory(staging: Path, destination: Path, previous: Path) -> None:
+    if previous.exists():
+        shutil.rmtree(previous)
+    if destination.exists():
+        destination.rename(previous)
+    staging.rename(destination)
+
+
+def _checkpoint_fingerprint(trainer: Any) -> dict:
+    adapter = trainer.adapter_config
+    training = trainer.training_config
+    return {
+        "adapter_type": trainer.adapter_type,
+        "model_variant": training.model_variant,
+        "dual_stream": bool(training.dual_stream),
+        "rank": getattr(adapter, "r", None),
+        "alpha": getattr(adapter, "alpha", None),
+        "dropout": getattr(adapter, "dropout", None),
+        "attention_type": getattr(adapter, "attention_type", None),
+        "target_modules": list(getattr(adapter, "target_modules", [])),
+        "val_split": float(getattr(training, "val_split", 0.0)),
+    }
+
+
+def _validate_checkpoint_fingerprint(trainer: Any, checkpoint_dir: Path) -> None:
+    config_path = checkpoint_dir / "run_config.json"
+    if not config_path.is_file():
+        raise ValueError(f"checkpoint compatibility metadata is missing: {config_path}")
+    saved = json.loads(config_path.read_text(encoding="utf-8")).get("fingerprint")
+    current = _checkpoint_fingerprint(trainer)
+    if saved != current:
+        raise ValueError(
+            "checkpoint configuration does not match this run: "
+            f"saved={saved}, current={current}"
+        )
+
