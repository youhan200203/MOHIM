index 0000000..72660f8
--- /dev/null
+++ b/acestep/training_v2/dual_stream.py
@@ -0,0 +1,147 @@
+"""Cover-style dual-stream adapter for accompaniment and vocal generation."""
+
+from __future__ import annotations
+
+import weakref
+from typing import Tuple
+
+import torch
+import torch.nn as nn
+
+
+ACCOMPANIMENT_ROLE = 0
+VOCAL_ROLE = 1
+
+
+class DualStreamConditioner(nn.Module):
+    """Add a role token and a zero-initialized temporal motif projection."""
+
+    def __init__(
+        self,
+        latent_dim: int,
+        condition_dim: int,
+        hidden_dim: int,
+        patch_size: int,
+    ) -> None:
+        super().__init__()
+        self.latent_dim = latent_dim
+        self.condition_dim = condition_dim
+        self.hidden_dim = hidden_dim
+        self.patch_size = patch_size
+        self.role_embedding = nn.Embedding(2, condition_dim)
+        self.motif_projection = nn.Conv1d(
+            in_channels=latent_dim,
+            out_channels=hidden_dim,
+            kernel_size=patch_size,
+            stride=patch_size,
+            padding=0,
+        )
+        nn.init.zeros_(self.motif_projection.weight)
+        nn.init.zeros_(self.motif_projection.bias)
+
+    def build_condition(
+        self,
+        encoder_hidden_states: torch.Tensor,
+        encoder_attention_mask: torch.Tensor,
+        role: int,
+    ) -> Tuple[torch.Tensor, torch.Tensor]:
+        """Prefix text/lyric conditions with a role token only."""
+        if role not in (ACCOMPANIMENT_ROLE, VOCAL_ROLE):
+            raise ValueError(f"unknown dual-stream role: {role}")
+        batch_size = encoder_hidden_states.shape[0]
+        role_ids = torch.full(
+            (batch_size,), role, device=encoder_hidden_states.device, dtype=torch.long
+        )
+        role_token = self.role_embedding(role_ids).unsqueeze(1)
+        role_mask = torch.ones(
+            batch_size, 1, device=encoder_attention_mask.device, dtype=torch.bool
+        )
+        condition = torch.cat([role_token, encoder_hidden_states], dim=1)
+        mask = torch.cat(
+            [role_mask, encoder_attention_mask.to(torch.bool)], dim=1
+        )
+        return condition, mask.to(dtype=encoder_attention_mask.dtype)
+
+    def project_motif(self, motif_latents: torch.Tensor) -> torch.Tensor:
+        """Project a full-resolution motif/silence canvas into DiT hidden space."""
+        if motif_latents.ndim != 3 or motif_latents.shape[-1] != self.latent_dim:
+            raise ValueError(
+                f"motif_latents must be [B, T, {self.latent_dim}], got {tuple(motif_latents.shape)}"
+            )
+        return self.motif_projection(motif_latents.transpose(1, 2)).transpose(1, 2)
+
+
+class DualStreamInputProjection(nn.Module):
+    """Preserve the pretrained 192-channel projection and add motif delta."""
+
+    def __init__(
+        self,
+        base_projection: nn.Module,
+        conditioner: DualStreamConditioner,
+    ) -> None:
+        super().__init__()
+        self.base_projection = base_projection
+        object.__setattr__(self, "_conditioner_ref", weakref.ref(conditioner))
+        for parameter in self.base_projection.parameters():
+            parameter.requires_grad = False
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        """Consume ``[peer | mask | motif | target]`` while reusing base weights."""
+        conditioner = self._conditioner_ref()
+        if conditioner is None:
+            raise RuntimeError("Dual-stream conditioner was released while projection is active.")
+        latent_dim = conditioner.latent_dim
+        expected_channels = latent_dim * 4
+        if hidden_states.shape[-1] != expected_channels:
+            raise ValueError(
+                f"dual-stream projection expected {expected_channels} channels, "
+                f"got {hidden_states.shape[-1]}"
+            )
+        peer_and_mask = hidden_states[..., : latent_dim * 2]
+        motif = hidden_states[..., latent_dim * 2 : latent_dim * 3]
+        target = hidden_states[..., latent_dim * 3 :]
+        base_input = torch.cat([peer_and_mask, target], dim=-1)
+        return self.base_projection(base_input) + conditioner.project_motif(motif)
+
+
+def attach_dual_stream_conditioner(
+    decoder: nn.Module,
+    *,
+    latent_dim: int,
+    condition_dim: int,
+    hidden_dim: int,
+    patch_size: int,
+) -> DualStreamConditioner:
+    """Attach the adapter and wrap the innermost decoder input projection."""
+    if getattr(decoder, "dual_stream_conditioner", None) is not None:
+        raise RuntimeError("Dual-stream conditioner is already attached.")
+    core = _find_decoder_core(decoder)
+    if isinstance(core.proj_in, DualStreamInputProjection):
+        raise RuntimeError("Dual-stream input projection is already installed.")
+    conditioner = DualStreamConditioner(
+        latent_dim=latent_dim,
+        condition_dim=condition_dim,
+        hidden_dim=hidden_dim,
+        patch_size=patch_size,
+    ).to(device=next(core.parameters()).device, dtype=next(core.parameters()).dtype)
+    decoder.add_module("dual_stream_conditioner", conditioner)
+    core.proj_in = DualStreamInputProjection(core.proj_in, conditioner)
+    return conditioner
+
+
+def _find_decoder_core(decoder: nn.Module) -> nn.Module:
+    """Find the DiT module that owns ``proj_in`` through PEFT wrappers."""
+    stack = [decoder]
+    visited: set[int] = set()
+    while stack:
+        current = stack.pop()
+        if id(current) in visited:
+            continue
+        visited.add(id(current))
+        if "proj_in" in current._modules:
+            return current
+        for attr in ("_forward_module", "_orig_mod", "base_model", "model", "module"):
+            child = getattr(current, attr, None)
+            if isinstance(child, nn.Module):
+                stack.append(child)
+    raise RuntimeError("Could not find the decoder module that owns proj_in.")
